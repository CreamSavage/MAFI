# Configuración SMTP para el envío de correos de Sistema MAFI
# Copia este archivo como ".env" y coloca tus credenciales reales.
# El archivo ".env" está protegido en .gitignore y bloqueado en .htaccess.

MAFI_SMTP_HOST=smtp.gmail.com
MAFI_SMTP_PORT=465
MAFI_SMTP_USER=sistemamafi@gmail.com
MAFI_SMTP_PASS=REEMPLAZA_CON_TU_APP_PASSWORD_DE_GOOGLE
MAFI_SMTP_FROM=sistemamafi@gmail.com
