# ==============================================================================
# Sistema MAFI - Configuración Apache (.htaccess)
# Optimización de carga, compresión GZIP, caché de navegador y seguridad básica
# ==============================================================================

# 1. Reescribir URLs y proteger listado de directorios
<IfModule mod_rewrite.c>
    Options -Indexes +FollowSymLinks
    RewriteEngine On
</IfModule>

# 2. Compresión GZIP / DEFLATE para activos de texto
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# 3. Política de expiración y caché del navegador
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML y PHP: sin caché agresivo para reflejar cambios dinámicos
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/x-httpd-php "access plus 0 seconds"

    # Imágenes, fuentes e iconos: 1 mes de caché
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # Hojas de estilo y scripts (versionados con ?v=...)
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 4. Cabeceras de seguridad y control de caché HTTP
<IfModule mod_headers.c>
    # Protección contra MIME sniffing y framing malicioso
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"

    # Caché inmutable para activos estáticos
    <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# 5. Restricción de acceso a archivos confidenciales o de entorno
<FilesMatch "(^\.git|^\.env|composer\.(json|lock)|backup.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
